<mxfile host="Electron" agent="Claude">
  <diagram name="Labor (Task) State Diagram (CU-07)" id="state-labor">
    <mxGraphModel dx="1030" dy="626" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="820" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="s0" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1">
          <mxGeometry height="20" width="20" x="310" y="30" as="geometry" />
        </mxCell>
        <mxCell id="pending" parent="1" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=12;fontStyle=1;" value="Pending (To Do)" vertex="1">
          <mxGeometry height="60" width="210" x="215" y="100" as="geometry" />
        </mxCell>
        <mxCell id="inprogress" parent="1" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=12;fontStyle=1;" value="InProgress" vertex="1">
          <mxGeometry height="60" width="210" x="215" y="230" as="geometry" />
        </mxCell>
        <mxCell id="blocked" parent="1" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=12;fontStyle=1;" value="Blocked" vertex="1">
          <mxGeometry height="60" width="210" x="850" y="300" as="geometry" />
        </mxCell>
        <mxCell id="completed" parent="1" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=12;fontStyle=1;" value="Completed" vertex="1">
          <mxGeometry height="60" width="210" x="215" y="370" as="geometry" />
        </mxCell>
        <mxCell id="sf" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1">
          <mxGeometry height="28" width="28" x="306" y="476" as="geometry" />
        </mxCell>
        <mxCell id="sf_ring" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;" vertex="1">
          <mxGeometry height="36" width="36" x="302" y="472" as="geometry" />
        </mxCell>
        <mxCell id="n1" edge="1" parent="1" source="s0" style="html=1;endArrow=block;endFill=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;" target="pending" value="create() [RF-11: activity planned and/or assigned]">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n2" edge="1" parent="1" source="pending" style="html=1;endArrow=block;endFill=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;" target="inprogress" value="start() [RF-03: worker begins executing the activity]">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n3" edge="1" parent="1" source="inprogress" style="html=1;endArrow=block;endFill=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;" target="blocked" value="reportBlocker() [e.g. missing tool/input, see Entrega 2 mockup]">
          <mxGeometry relative="1" x="0.3131" y="10" as="geometry">
            <mxPoint as="offset" />
            <Array as="points">
              <mxPoint x="500" y="260" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="n4" edge="1" parent="1" source="blocked" style="html=1;endArrow=block;endFill=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;" target="inprogress" value="resolveBlocker()">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="960" y="250" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="n5" edge="1" parent="1" source="inprogress" style="html=1;endArrow=block;endFill=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;" target="completed" value="markCompleted() [RF-11]">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n6" edge="1" parent="1" source="completed" style="html=1;endArrow=block;endFill=1;fontSize=10;edgeStyle=orthogonalEdgeStyle;" target="sf">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note1" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=9;align=left;spacingLeft=6;size=14;" value="Note: TaskStatus enum (class diagram) has 3 values&#xa;(Pending, InProgress, Completed). Blocked is an&#xa;operational sub-state of InProgress, shown separately&#xa;here for traceability with the Entrega 2 kanban mockup." vertex="1">
          <mxGeometry height="70" width="250" x="610" y="380" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
